# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ OpenRouter (создай новый на openrouter.ai -> Keys)
OPENROUTER_API_KEY=

# Твой Telegram chat_id — сюда бот шлёт уведомления о новых лидах
# Узнать: напиши боту @userinfobot, он пришлёт твой ID
ADMIN_CHAT_ID=

# Модели OpenRouter через запятую — бот пробует по очереди, пока одна не ответит
# (бесплатные периодически перегружены, поэтому список).
# Стабильнее/качественнее позже: anthropic/claude-3.5-haiku (нужен баланс ~$5).
MODELS=deepseek/deepseek-v4-flash,openai/gpt-oss-120b:free,nvidia/nemotron-3-super-120b-a12b:free

# Сколько карт в сутки собирает один человек: каждая карта — платный вызов модели.
DAILY_LIMIT=3

# Через сколько минут напомнить тому, кто бросил квиз на середине (одно напоминание).
REMIND_AFTER_MINUTES=60

# Передача лидов в AI-CRM: адрес /webhook/lead и общий секрет (WEBHOOK_SECRET в CRM).
# Лид уходит сразу, как человек оставил телефон, или через CRM_WAIT_MINUTES без него.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WAIT_MINUTES=10

# Строка в Google Sheets на каждый лид: адрес веб-приложения Apps Script и общий токен.
# Код скрипта — в README.
SHEETS_WEBHOOK_URL=
SHEETS_TOKEN=

# Тот же квиз в мессенджере MAX: токен бота с dev.max.ru. Пусто — только Telegram.
MAX_BOT_TOKEN=
